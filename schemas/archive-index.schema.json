{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jong-support.example/schemas/archive-index.schema.json",
  "title": "Jong Support Archive Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "archives"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "archives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/archiveIndexEntry"
      }
    }
  },
  "$defs": {
    "archiveIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archiveId",
        "title",
        "date",
        "revision",
        "file",
        "formatVersion",
        "archiveSchemaVersion",
        "playerCount",
        "gameCount",
        "hasSubgame"
      ],
      "properties": {
        "archiveId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "file": {
          "type": "string",
          "pattern": "^archives/[A-Za-z0-9][A-Za-z0-9._-]*\\.enc$"
        },
        "formatVersion": {
          "const": 1
        },
        "archiveSchemaVersion": {
          "const": "1.0.0"
        },
        "playerCount": {
          "type": "integer",
          "minimum": 1
        },
        "gameCount": {
          "type": "integer",
          "minimum": 0
        },
        "hasSubgame": {
          "type": "boolean"
        }
      }
    }
  }
}
